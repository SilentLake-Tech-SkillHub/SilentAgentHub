# sandbox | live
ALIPAY_ENV=sandbox

# Account identity. Never guess these values.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=

# Keep private material outside Git. File injection is required in live.
ALIPAY_APP_PRIVATE_KEY_FILE=/run/secrets/alipay-app-private-key.txt
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay-public-key.txt

# Optional inline values are for isolated local/sandbox use only.
# ALIPAY_APP_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=

# Leave blank to use the environment default gateway.
ALIPAY_GATEWAY_URL=
ALIPAY_RETURN_URL=https://example.com/api/billing/alipay/return
ALIPAY_NOTIFY_URL=https://example.com/api/billing/alipay/notify

# Fixed-price account-credit example. Replace with your product pricing.
ALIPAY_ORDER_AMOUNT_CNY_CENTS=730
ALIPAY_CREDIT_UNITS=500000
ALIPAY_ORDER_SUBJECT=Account usage credit
ALIPAY_TIMEOUT_EXPRESS=30m

# Local reference store. Production may replace it with an equivalent repository.
ALIPAY_DB_PATH=/data/app/alipay-payments.sqlite3
