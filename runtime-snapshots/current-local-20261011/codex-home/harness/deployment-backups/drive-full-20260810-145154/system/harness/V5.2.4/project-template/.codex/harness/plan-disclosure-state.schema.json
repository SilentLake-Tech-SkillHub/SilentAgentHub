{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-plan-disclosure-state.schema.json",
  "title": "Codex Plan Disclosure State",
  "type": "object",
  "required": ["$schema", "version", "updatedAt", "records"],
  "properties": {
    "$schema": { "const": "./plan-disclosure-state.schema.json" },
    "version": { "const": "1.0.0" },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "records": { "type": "array", "maxItems": 200, "items": {
      "type": "object",
      "required": ["conversationId", "turnId", "promptHash", "planPath", "planHash", "queryRoute", "state", "registeredAt", "disclosedAt"],
      "properties": {
        "conversationId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "turnId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "promptHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "planPath": { "type": "string", "minLength": 1 },
        "planHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "queryRoute": { "enum": ["plan_create_or_update", "plan_redisclose"] },
        "state": { "enum": ["pending", "disclosed"] },
        "registeredAt": { "type": "string", "format": "date-time" },
        "disclosedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
