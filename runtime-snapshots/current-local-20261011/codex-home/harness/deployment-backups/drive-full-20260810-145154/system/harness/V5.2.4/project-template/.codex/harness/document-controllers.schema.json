{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "policy",
    "controllers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "required": [
        "oneControllerPerDocument",
        "routerPathOnly",
        "forbiddenMarkdownArtifacts",
        "runtimeEventLog",
        "lifecycleMachine",
        "humanLedgerContract"
      ],
      "properties": {
        "oneControllerPerDocument": {
          "const": true
        },
        "routerPathOnly": {
          "const": true
        },
        "forbiddenMarkdownArtifacts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "runtimeEventLog": {
          "type": "string",
          "minLength": 1
        },
        "lifecycleMachine": {
          "type": "string",
          "minLength": 1
        },
        "humanLedgerContract": {
          "type": "object",
          "required": ["requiredFields", "rawRuntimeSource", "rule"],
          "properties": {
            "requiredFields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 7, "uniqueItems": true },
            "rawRuntimeSource": { "type": "string", "minLength": 1 },
            "rule": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "controllers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "skill",
          "path",
          "area",
          "condition",
          "template",
          "status",
          "documentType",
          "readPolicy",
          "archivePolicy"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^doc-[a-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "enum": [
              "root",
              "product",
              "flow",
              "knowledge",
              "code"
            ]
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "candidate",
              "active",
              "deprecated"
            ]
          },
          "documentType": {
            "enum": ["spec", "ledger", "dynamic-ledger", "index"]
          },
          "readPolicy": {
            "enum": ["always", "active", "conditional", "cold"]
          },
          "statusField": {
            "type": "string",
            "minLength": 1
          },
          "terminalStates": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "archivePolicy": {
            "enum": ["none", "controller_defined", "terminal_to_history", "short_to_long"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
