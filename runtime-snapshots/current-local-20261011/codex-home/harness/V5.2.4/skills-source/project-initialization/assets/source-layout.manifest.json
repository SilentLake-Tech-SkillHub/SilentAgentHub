{
  "schema_version": "1.0",
  "base_path": "代码管理/代码仓",
  "coverage_roots": [".", "src", "src/server"],
  "coverage_exclusions": [".git", ".next", ".turbo", ".venv", "build", "coverage", "dist", "node_modules", "vendor"],
  "entries": [
    { "path": "src", "role": "源代码分组根目录。", "enabled": false },
    { "path": "src/app", "role": "页面、路由、布局和应用入口。", "enabled": false },
    { "path": "src/components", "role": "可复用 UI 组件和业务展示组件。", "enabled": false },
    { "path": "src/hooks", "role": "前端状态逻辑和 React hooks。", "enabled": false },
    { "path": "src/styles", "role": "全局样式、主题变量和动画。", "enabled": false },
    { "path": "src/services", "role": "前端 API 调用或跨端业务服务。", "enabled": false },
    { "path": "src/server", "role": "后端分组根目录。", "enabled": false },
    { "path": "src/server/routes", "role": "HTTP 路由定义。", "enabled": false },
    { "path": "src/server/controllers", "role": "请求与响应处理。", "enabled": false },
    { "path": "src/server/services", "role": "后端业务逻辑和流程编排。", "enabled": false },
    { "path": "src/server/repositories", "role": "数据库访问和持久化逻辑。", "enabled": false },
    { "path": "src/server/models", "role": "数据模型、DTO 和类型定义。", "enabled": false },
    { "path": "src/server/middlewares", "role": "鉴权、校验、限流和错误处理。", "enabled": false },
    { "path": "src/server/config", "role": "环境变量、数据库、日志和第三方配置。", "enabled": false },
    { "path": "src/agents", "role": "Agent 编排、计划、执行和评审逻辑。", "enabled": false },
    { "path": "src/tools", "role": "Agent 可调用的搜索、SQL、浏览器、地图和外部 API 等工具。", "enabled": false },
    { "path": "src/prompts", "role": "Prompt 模板；不得把大型 Prompt 硬编码在业务代码中。", "enabled": false },
    { "path": "src/memory", "role": "会话记忆、用户偏好、摘要和向量记忆。", "enabled": false },
    { "path": "src/guardrails", "role": "安全检查、权限检查、PII 过滤和风控规则。", "enabled": false },
    { "path": "src/retrieval", "role": "RAG、切块、embedding、向量检索、query rewrite 和 rerank。", "enabled": false },
    { "path": "src/observability", "role": "日志、trace、token usage、cost、metrics 和 error reporting。", "enabled": false },
    { "path": "src/utils", "role": "通用工具函数。", "enabled": false },
    { "path": "tests", "role": "单元测试、集成测试和端到端测试。", "enabled": false },
    { "path": "evals", "role": "AI 行为评估、golden cases、metrics 和 judge rubric。", "enabled": false },
    { "path": "scripts", "role": "初始化、运行、验证和报告生成脚本。", "enabled": false },
    { "path": "docs", "role": "工程文档、API 文档、部署文档和操作手册。", "enabled": false }
  ]
}
