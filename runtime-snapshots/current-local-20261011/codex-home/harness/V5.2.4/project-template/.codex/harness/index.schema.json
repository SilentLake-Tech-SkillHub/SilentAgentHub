{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-harness-index.schema.json",
  "title": "Codex Harness Project Index",
  "type": "object",
  "required": [
    "version",
    "status",
    "requiredCloseoutPaths",
    "planRoot",
    "productDemandPool",
    "engineeringScopeLedger",
    "architectureSource",
    "knowledgeSyncRecord",
    "handoffRecord",
    "memoryRules",
    "shortMemory",
    "longMemory",
    "memoryPolicy",
    "planDisclosureState",
    "planDisclosureSchema",
    "knowledgeRouter",
    "ledgerRetention",
    "historyIndex",
    "documentControllerRegistry",
    "lifecycleStateMachine",
    "runtimeEventLog",
    "performancePolicy",
    "performancePolicySchema",
    "sourceLayoutManifest",
    "sourceLayoutRequired"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate-not-installed", "reviewed", "active", "production", "disabled"] },
    "requiredCloseoutPaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "planRoot": { "type": "string", "minLength": 1 },
    "productDemandPool": { "type": "string", "minLength": 1 },
    "engineeringScopeLedger": { "type": "string", "minLength": 1 },
    "architectureSource": { "type": "string", "minLength": 1 },
    "knowledgeSyncRecord": { "type": "string", "minLength": 1 },
    "handoffRecord": { "type": "string", "minLength": 1 },
    "memoryRules": { "const": "MEMORY.md" },
    "shortMemory": { "const": "SHORT_MEMORY.md" },
    "longMemory": { "const": "LONG_MEMORY.md" },
    "memoryPolicy": { "type": "string", "minLength": 1 },
    "planDisclosureState": { "type": "string", "minLength": 1 },
    "planDisclosureSchema": { "type": "string", "minLength": 1 },
    "knowledgeRouter": { "type": "string", "minLength": 1 },
    "ledgerRetention": { "type": "string", "minLength": 1 },
    "historyIndex": { "type": "string", "minLength": 1 },
    "documentControllerRegistry": { "type": "string", "minLength": 1 },
    "lifecycleStateMachine": { "type": "string", "minLength": 1 },
    "runtimeEventLog": { "type": "string", "minLength": 1 },
    "performancePolicy": { "type": "string", "minLength": 1 },
    "performancePolicySchema": { "type": "string", "minLength": 1 },
    "sourceLayoutManifest": { "type": "string", "minLength": 1 },
    "sourceLayoutRequired": { "type": "boolean" }
  },
  "additionalProperties": false
}
